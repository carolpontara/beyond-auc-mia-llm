{
  "seed": 42,
  "output_dir": "output",
  "model_name": "distilgpt2",
  "dataset_name": "wikitext",
  "dataset_config": "wikitext-2-raw-v1",
  "text_column": "text",
  "max_train_texts": 4000,
  "max_eval_texts": 800,
  "max_length": 128,
  "block_size": 128,
  "num_train_epochs": 1,
  "learning_rate": 5e-05,
  "train_batch_size": 4,
  "eval_batch_size": 4,
  "gradient_accumulation_steps": 1,
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "logging_steps": 50,
  "save_total_limit": 1,
  "fp16": false,
  "num_canaries": 25,
  "canary_repetitions": 4,
  "member_sample_size": 150,
  "nonmember_sample_size": 150,
  "num_attack_runs": 3,
  "neighborhood_variants": 3,
  "min_k_ratio": 0.2,
  "attacks": [
    "loss",
    "ref_gap",
    "min_k"
  ]
}